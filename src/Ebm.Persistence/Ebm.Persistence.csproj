<Project Sdk="Microsoft.NET.Sdk">

  <!-- Persistence layer: database, migrations, repositories, save games. Implements ports defined in Services. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ebm.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Design-time only: lets `dotnet ef` create migrations. Not shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ebm.Domain\Ebm.Domain.csproj" />
    <ProjectReference Include="..\Ebm.Services\Ebm.Services.csproj" />
  </ItemGroup>

</Project>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tr="clr-namespace:Ebm.Desktop.ViewModels.Training">
  <!-- Training screen (Step 21). Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->

  <DataTemplate DataType="{x:Type tr:TrainingViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="280" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Team focus" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Focuses}" SelectedItem="{Binding TeamFocus}" Width="150" />
            <TextBlock Text="Intensity" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="20,0,8,0" />
            <ComboBox ItemsSource="{Binding Intensities}" SelectedItem="{Binding Intensity}" Width="120" />
            <Button Content="Save training plan" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" Margin="20,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding StaffText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="Outlook: expected overall change over a year with the saved plan, at average luck. Hard training develops more but recovers less fitness."
                     Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <DataGrid ItemsSource="{Binding Players}" Style="{StaticResource Editor.Grid}" IsReadOnly="False" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="140" />
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" IsReadOnly="True" Width="103" />
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" IsReadOnly="True" Width="53" />
          <DataGridTextColumn Header="Ovr" Binding="{Binding Overall}" IsReadOnly="True" Width="53" ElementStyle="{StaticResource Cell.Rating}" />
          <DataGridTextColumn Header="Pot" Binding="{Binding Potential}" IsReadOnly="True" Width="53" ElementStyle="{StaticResource Cell.Rating}" />
          <DataGridTextColumn Header="Fitness" Binding="{Binding Fitness}" IsReadOnly="True" Width="68" />
          <DataGridTextColumn Header="Exp" Binding="{Binding Experience}" IsReadOnly="True" Width="53" />
          <DataGridTextColumn Header="Outlook" Binding="{Binding Outlook}" IsReadOnly="True" Width="73" />
          <DataGridTemplateColumn Header="Individual focus" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding DataContext.IndividualFocuses, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Focus, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

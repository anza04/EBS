<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pl="clr-namespace:Ebm.Desktop.ViewModels.Players">
  <!-- Player profile and comparison screens. Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->

  <!-- Label/value lines (InfoLine). -->
  <DataTemplate x:Key="Players.Lines">
    <ItemsControl ItemsSource="{Binding}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="0,2">
            <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" Margin="0,0,12,0" />
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>

  <DataTemplate DataType="{x:Type pl:PlayerProfileViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Player" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Players}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PlayerId}" Width="280" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="Details" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                <ContentControl Content="{Binding Details}" ContentTemplate="{StaticResource Players.Lines}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Ratings" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                <ContentControl Content="{Binding Ratings}" ContentTemplate="{StaticResource Players.Lines}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="Position suitability" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Positions}" Style="{StaticResource Editor.Grid}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="140" />
                    <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="70" />
                    <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveRating}" Width="70" />
                    <DataGridTextColumn Header="Familiarity" Binding="{Binding Familiarity}" Width="100" />
                    <DataGridTextColumn Header="Suitability" Binding="{Binding Suitability}" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,8,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                      <ContentControl Content="{Binding Lines}" ContentTemplate="{StaticResource Players.Lines}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type pl:PlayerComparisonViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Compare" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Players}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PlayerA}" Width="260" />
        <TextBlock Text="with" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Players}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PlayerB}" Width="260" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource Editor.Grid}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="110" />
          <DataGridTextColumn Header="Value" Binding="{Binding Label}" Width="180" />
          <DataGridTextColumn Binding="{Binding A}" Width="140">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.NameA, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding B}" Width="140">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.NameB, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Better" Binding="{Binding Better}" Width="200" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tc="clr-namespace:Ebm.Desktop.ViewModels.Tactical">
  <!-- Tactics screen (Step 09). Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->

  <DataTemplate DataType="{x:Type tc:TacticsViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="280" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Saved tactics" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="New tactic" Command="{Binding NewCommand}" Style="{StaticResource Button.Secondary}" />
            <Button Content="Use for the next match" Command="{Binding UseForNextMatchCommand}" Style="{StaticResource Button.Secondary}" Margin="0,6,0,0" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource Button.Secondary}" Margin="0,6,0,0" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedTactic}" DisplayMemberPath="Name" />
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Text="Name" Style="{StaticResource Form.Label}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Offense" Style="{StaticResource Text.Title}" Margin="0,12,0,0" />
              <TextBlock Text="System" Style="{StaticResource Form.Label}" />
              <ComboBox ItemsSource="{Binding OffensiveSystems}" SelectedItem="{Binding OffensiveSystem}" />
              <TextBlock Text="Tempo · shot selection · ball movement · spacing · pick and roll (1–5)" Style="{StaticResource Form.Label}" />
              <UniformGrid Columns="5">
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Tempo}" ToolTip="Tempo" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding ShotSelection}" ToolTip="Shot selection" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding BallMovement}" ToolTip="Ball movement" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Spacing}" ToolTip="Spacing" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding PickAndRollFrequency}" ToolTip="Pick-and-roll frequency" />
              </UniformGrid>
              <TextBlock Text="Offensive focus" Style="{StaticResource Form.Label}" />
              <ComboBox ItemsSource="{Binding Focuses}" SelectedItem="{Binding Focus}" />

              <TextBlock Text="Defense" Style="{StaticResource Text.Title}" Margin="0,12,0,0" />
              <TextBlock Text="System" Style="{StaticResource Form.Label}" />
              <ComboBox ItemsSource="{Binding DefensiveSystems}" SelectedItem="{Binding DefensiveSystem}" />
              <TextBlock Text="Intensity · ball pressure · help defense (1–5)" Style="{StaticResource Form.Label}" />
              <UniformGrid Columns="3">
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Intensity}" ToolTip="Defensive intensity" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding BallPressure}" ToolTip="Ball pressure" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding HelpDefense}" ToolTip="Help defense" />
              </UniformGrid>
              <TextBlock Text="Switching" Style="{StaticResource Form.Label}" />
              <ComboBox ItemsSource="{Binding SwitchingPolicies}" SelectedItem="{Binding Switching}" />
              <TextBlock Text="Pick-and-roll coverage" Style="{StaticResource Form.Label}" />
              <ComboBox ItemsSource="{Binding Coverages}" SelectedItem="{Binding Coverage}" />
              <TextBlock Text="Rebounding" Style="{StaticResource Form.Label}" />
              <ComboBox ItemsSource="{Binding ReboundingPriorities}" SelectedItem="{Binding Rebounding}" />
              <Button Content="Save tactic" Command="{Binding SaveCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
          </Border>
        </ScrollViewer>

        <DockPanel Grid.Column="2" Margin="12,0,0,0">
          <TextBlock DockPanel.Dock="Top" Text="Player roles (saved with the tactic)" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
          <DataGrid ItemsSource="{Binding Assignments}" Style="{StaticResource Editor.Grid}" IsReadOnly="False" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="130" />
              <DataGridTextColumn Header="Pos" Binding="{Binding Position}" IsReadOnly="True" Width="95" />
              <DataGridTextColumn Header="Squad" Binding="{Binding Squad}" IsReadOnly="True" Width="80" />
              <DataGridTemplateColumn Header="Role" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Shots" Width="60">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.Levels, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding ShotPriority, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Minutes" Width="65">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding MinutesTarget, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Suggested" Binding="{Binding Suggested}" IsReadOnly="True" Width="130" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

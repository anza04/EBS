<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="clr-namespace:Ebm.Desktop.ViewModels.Modding">
  <!-- Mods and export (Step 33, docs/MODDING.md). Uses the tokens and styles from Shell.xaml and Editor.xaml. -->
  <Style x:Key="Mods.SeverityCell" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
    <Style.Triggers>
      <Trigger Property="Text" Value="Warning">
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <DataTemplate DataType="{x:Type md:ModsViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock Text="Mods and export" Style="{StaticResource Text.Heading}" />
        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap">
          <Run Text="Install community databases, share your own, or export the database to edit it. Installing never breaks your game: it is saved first and restored if anything goes wrong. Mods folder: " />
          <Run Text="{Binding Folder, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" Margin="0,8,0,0" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Packages -->
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Add package…" Command="{Binding AddPackageCommand}" Margin="0,0,8,0" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
                <Button Content="Refresh" Command="{Binding RefreshListCommand}" />
              </StackPanel>
              <TextBlock Text="Community packages" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <TextBlock Text="{Binding SelectedPackage.Description}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <StackPanel Orientation="Horizontal">
                <Button Content="Check" Command="{Binding CheckPackageCommand}" Margin="0,0,8,0"
                        ToolTip="Runs the import as a test against the current game: nothing is written" />
                <Button Content="Install into current game" Command="{Binding InstallIntoCurrentGameCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                        ToolTip="Adds the package's records to the game in progress; records with the same ID are updated" />
                <Button Content="{Binding NewGameButtonText}" Command="{Binding InstallAsNewGameCommand}" Style="{StaticResource Button.Danger}"
                        ToolTip="Replaces the game in progress with only the package's data (your saves are kept)" />
              </StackPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding PackageRows}" SelectedItem="{Binding SelectedPackage}" Style="{StaticResource Editor.Grid}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*" MinWidth="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" MinWidth="140" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- Problems of the last check, install or validation -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding IssuesTitle}" Style="{StaticResource Text.Title}" Margin="0,0,0,10" />
            <DataGrid ItemsSource="{Binding Issues}" Style="{StaticResource Editor.Grid}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Severity}" Width="80" ElementStyle="{StaticResource Mods.SeverityCell}" />
                <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="110" />
                <DataGridTextColumn Header="Record" Binding="{Binding Subject}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Problem" Binding="{Binding Message}" Width="3*" MinWidth="220" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- Share and export -->
        <ScrollViewer Grid.Column="2" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Create a package" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Packs the current database (clubs, players, competitions …) into a file others can install."
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="Name" Style="{StaticResource Form.Label}" />
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Serie A 2026-27 update" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Author" Style="{StaticResource Form.Label}" />
                    <TextBox Text="{Binding NewAuthor, UpdateSourceTrigger=PropertyChanged}" Tag="Your name" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Version" Style="{StaticResource Form.Label}" />
                    <TextBox Text="{Binding NewVersion, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Description" Style="{StaticResource Form.Label}" />
                <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Tag="What the package contains"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />
                <Button Content="Create package" Command="{Binding CreatePackageCommand}" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Export the database" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Writes one JSON file in the import format. Edit it in any text editor or spreadsheet tool and import it again."
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                <Button Content="Export to JSON…" Command="{Binding ExportDatasetCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Check the database" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Looks for data that breaks the game's rules: overlapping contracts, short squads, unreadable competition rules."
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                <Button Content="Check now" Command="{Binding ValidateDatabaseCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

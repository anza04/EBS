<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tr="clr-namespace:Ebm.Desktop.ViewModels.Transfers">
  <!-- Transfer market screen (Step 08). Uses the tokens from Shell.xaml, the styles from Editor.xaml and Players.Lines from Players.xaml. -->

  <BooleanToVisibilityConverter x:Key="Transfers.Visible" />

  <DataTemplate DataType="{x:Type tr:TransferMarketViewModel}">
    <DockPanel Margin="16">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Content="Run the AI transfer window" Command="{Binding RunAiWindowCommand}" Style="{StaticResource Button.Secondary}"
                ToolTip="Every other club sells its surplus, signs free agents and buys players with the AI rules. Your club is left alone." />
        <TextBlock Text="Your club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="260" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Player search" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
          <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Name contains" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding PositionOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SearchPosition}" Width="130" ToolTip="Position (primary or secondary)" Margin="0,0,8,6" />
            <TextBox Text="{Binding MinAge, UpdateSourceTrigger=PropertyChanged}" Width="55" ToolTip="Minimum age" Margin="0,0,4,6" />
            <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,6" />
            <TextBox Text="{Binding MaxAge, UpdateSourceTrigger=PropertyChanged}" Width="55" ToolTip="Maximum age" Margin="0,0,8,6" />
            <TextBox Text="{Binding MinOverall, UpdateSourceTrigger=PropertyChanged}" Width="60" ToolTip="Minimum overall" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="140" ToolTip="Who to show" Margin="0,0,8,6" />
            <TextBox Text="{Binding MaxFee, UpdateSourceTrigger=PropertyChanged}" Width="100" ToolTip="Maximum fee (€)" Margin="0,0,8,6" />
            <TextBox Text="{Binding MaxSalary, UpdateSourceTrigger=PropertyChanged}" Width="100" ToolTip="Maximum salary he would ask (€ a year)" Margin="0,0,8,6" />
            <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
            <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,0,6" />
          </WrapPanel>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedPlayer}" Style="{StaticResource Editor.Grid}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*" MinWidth="130" />
              <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="95" />
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="40" />
              <DataGridTextColumn Header="Ovr" Binding="{Binding Overall}" Width="40" />
              <DataGridTextColumn Header="Pot" Binding="{Binding Potential}" Width="40" />
              <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="140" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
              <DataGridTextColumn Header="Until" Binding="{Binding ContractEnd}" Width="85" />
              <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="90" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="95" />
              <DataGridTextColumn Header="Asking fee" Binding="{Binding Fee}" Width="95" />
              <DataGridTextColumn Header="Clause" Binding="{Binding ReleaseClause}" Width="95" />
              <DataGridTextColumn Header="Loan" Binding="{Binding Loan}" Width="110" />
              <DataGridTextColumn Header="Would ask" Binding="{Binding AskingSalary}" Width="95" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="3" Text="Transfer history of your club" Style="{StaticResource Text.Title}" Margin="0,12,0,6" />
          <DataGrid Grid.Row="4" ItemsSource="{Binding History}" Style="{StaticResource Editor.Grid}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="85" />
              <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="*" MinWidth="130" />
              <DataGridTextColumn Header="From" Binding="{Binding From}" Width="140" />
              <DataGridTextColumn Header="To" Binding="{Binding To}" Width="140" />
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="200" />
              <DataGridTextColumn Header="Fee" Binding="{Binding Fee}" Width="95" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ContentControl Content="{Binding PlayerDetails}" ContentTemplate="{StaticResource Players.Lines}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0" IsEnabled="{Binding HasSelection}">
              <StackPanel>
                <TextBlock Text="Offer" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
                <StackPanel Visibility="{Binding SelectedUnderContract, Converter={StaticResource Transfers.Visible}}">
                  <TextBlock Text="Transfer fee (€)" Style="{StaticResource Form.Label}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Fee, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <Button Content="Ask the club" Command="{Binding AskClubCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
                    <Button Content="Use its counter" Command="{Binding UseClubCounterCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
                  </StackPanel>
                </StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Annual salary (€)" Style="{StaticResource Form.Label}" />
                    <TextBox Text="{Binding OfferSalary, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Signing bonus (€)" Style="{StaticResource Form.Label}" />
                    <TextBox Text="{Binding OfferSigningBonus, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Contract until" Style="{StaticResource Form.Label}" />
                    <DatePicker SelectedDate="{Binding OfferEnd}" />
                    <TextBlock Text="Joins as" Style="{StaticResource Form.Label}" />
                    <ComboBox ItemsSource="{Binding JoinRoles}" SelectedItem="{Binding JoinAs}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="The contract starts today; the other terms are the defaults (monthly pay, no bonuses, no options)." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Ask the player" Command="{Binding AskPlayerCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
                  <Button Content="Use his counter" Command="{Binding UsePlayerCounterCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
                  <Button Content="Sign the free agent" Command="{Binding SignFreeAgentCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6"
                          Visibility="{Binding SelectedIsFreeAgent, Converter={StaticResource Transfers.Visible}}" />
                  <Button Content="Buy" Command="{Binding BuyCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6"
                          Visibility="{Binding SelectedUnderContract, Converter={StaticResource Transfers.Visible}}" />
                  <Button Content="Pay the release clause" Command="{Binding PayReleaseClauseCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6"
                          Visibility="{Binding SelectedHasClause, Converter={StaticResource Transfers.Visible}}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding SelectedUnderContract, Converter={StaticResource Transfers.Visible}}">
                  <TextBlock Text="Loan" Style="{StaticResource Text.Title}" Margin="0,8,0,4" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Loan until" Style="{StaticResource Form.Label}" />
                      <DatePicker SelectedDate="{Binding LoanUntil}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Loan fee (€)" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding LoanFee, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Your club pays his salary while he is with you; he goes back when the loan ends or when his club recalls him." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="Ask the club" Command="{Binding AskLoanCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
                    <Button Content="Use its counter" Command="{Binding UseLoanCounterCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
                    <Button Content="Take on loan" Command="{Binding LoanCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,6" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock Text="{Binding Negotiation}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Your players out on loan" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding LoansOut}" SelectedItem="{Binding SelectedLoan}" Style="{StaticResource Editor.Grid}" MaxHeight="140">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="*" />
                    <DataGridTextColumn Header="At" Binding="{Binding To}" Width="120" />
                    <DataGridTextColumn Header="Until" Binding="{Binding LoanEnd}" Width="85" />
                  </DataGrid.Columns>
                </DataGrid>
                <Button Content="Recall the selected player" Command="{Binding RecallCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock Text="Players on loan with you" Style="{StaticResource Text.Title}" Margin="0,12,0,6" />
                <DataGrid ItemsSource="{Binding LoansIn}" Style="{StaticResource Editor.Grid}" MaxHeight="140">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="*" />
                    <DataGridTextColumn Header="From" Binding="{Binding From}" Width="120" />
                    <DataGridTextColumn Header="Until" Binding="{Binding LoanEnd}" Width="85" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="AI transfer window" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
                <ContentControl Content="{Binding AiReport}" ContentTemplate="{StaticResource Players.Lines}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

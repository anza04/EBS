<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ch="clr-namespace:Ebm.Desktop.ViewModels.Chemistry">
  <!-- Dressing room (Step 26). Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->

  <DataTemplate DataType="{x:Type ch:DressingRoomViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="280" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding ChemistryText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
          <TextBlock Text="Chemistry of the starters and first three rotation players (50 = neutral). Role and expected minutes come from the player's rank in the squad (or his contract promise); recent minutes are per club game over the last four weeks. (C) captain, (L) leader. Unsettled: unhappy and short of minutes."
                     Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Players}" Style="{StaticResource Editor.Grid}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="35" />
            <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="95" />
            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80" />
            <DataGridTextColumn Header="Expected min" Binding="{Binding Expected}" Width="110" />
            <DataGridTextColumn Header="Recent min" Binding="{Binding Recent}" Width="80" />
            <DataGridTextColumn Header="Satisfaction" Binding="{Binding Satisfaction}" Width="90" />
            <DataGridTextColumn Header="Morale" Binding="{Binding Morale}" Width="60" />
            <DataGridTextColumn Header="Leadership" Binding="{Binding Leadership}" Width="80" />
            <DataGridTextColumn Header="Conflict" Binding="{Binding Conflict}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Text="Relationships (strongest and weakest)" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Relationships}" Style="{StaticResource Editor.Grid}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Player" Binding="{Binding First}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Teammate" Binding="{Binding Second}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

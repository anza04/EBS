<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nw="clr-namespace:Ebm.Desktop.ViewModels.News">
  <!-- News (Step 31). Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->

  <DataTemplate DataType="{x:Type nw:NewsViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding ClubChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="280" />
        <TextBlock Text="Category" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="20,0,8,0" />
        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Category}" Width="180" />
      </StackPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding FansText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
          <TextBlock Text="Stories are written at the end of each game day from what happened: matches, transfers, injuries, contracts, reputation and the fans. Nothing is ever deleted."
                     Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <DataGrid Grid.Column="0" ItemsSource="{Binding Stories}" SelectedItem="{Binding Selected}" Style="{StaticResource Editor.Grid}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120" />
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
            <DataGridTextColumn Header="" Binding="{Binding Tone}" Width="30" />
            <DataGridTextColumn Header="Headline" Binding="{Binding Headline}" Width="*" MinWidth="200" />
          </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <TextBlock Grid.Row="1" Text="Reputation history (newest first)" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Reputation}" Style="{StaticResource Editor.Grid}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
              <DataGridTextColumn Header="Event" Binding="{Binding Cause}" Width="*" />
              <DataGridTextColumn Header="Reputation" Binding="{Binding Change}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="clr-namespace:Ebm.Desktop.ViewModels.Medical">
  <!-- Medical room (Step 22). Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->

  <DataTemplate DataType="{x:Type md:MedicalViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="280" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding StaffText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
          <TextBlock Text="Return: the medical staff's estimate (better physios estimate better and heal faster). Risk: injury risk against an average player, from fitness, workload, age, physique, injury history and medical care."
                     Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Players}" Style="{StaticResource Editor.Grid}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="103" />
            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="53" />
            <DataGridTextColumn Header="Fitness" Binding="{Binding Fitness}" Width="68" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="93" />
            <DataGridTextColumn Header="Injury" Binding="{Binding Injury}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="105" />
            <DataGridTextColumn Header="Training" Binding="{Binding Training}" Width="110" />
            <DataGridTextColumn Header="Return" Binding="{Binding Return}" Width="103" />
            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="58" />
            <DataGridTextColumn Header="Injuries (year)" Binding="{Binding RecentInjuries}" Width="103" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Text="Injury history (last year)" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding History}" Style="{StaticResource Editor.Grid}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="103" />
            <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Injury" Binding="{Binding Injury}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="88" />
            <DataGridTextColumn Header="Where" Binding="{Binding Source}" Width="83" />
            <DataGridTextColumn Header="Back" Binding="{Binding Back}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared visual tokens. Screens must use these keys instead of literal colours. -->
  <SolidColorBrush x:Key="Brush.Background" Color="#F3F4F6" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Border" Color="#D9DCE1" />
  <SolidColorBrush x:Key="Brush.Header" Color="#14213D" />
  <SolidColorBrush x:Key="Brush.HeaderText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.HeaderMuted" Color="#B8C1D6" />
  <SolidColorBrush x:Key="Brush.Text" Color="#1F2933" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#5F6B7A" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#E8590C" />

  <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>
  <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>
  <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="28" />
  </Style>

  <Style x:Key="Button.Secondary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
</ResourceDictionary>

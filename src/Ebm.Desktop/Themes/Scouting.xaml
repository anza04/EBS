<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sc="clr-namespace:Ebm.Desktop.ViewModels.Scouting">
  <!-- Scouting screen (Step 20). Uses the tokens from Shell.xaml, the styles from Editor.xaml and Players.Lines from Players.xaml. -->

  <DataTemplate DataType="{x:Type sc:ScoutingViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="280" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Scouts" Style="{StaticResource Text.Title}" Margin="0,0,0,6" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding Scouts}" Style="{StaticResource Editor.Grid}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Scout" Binding="{Binding Name}" Width="180" />
              <DataGridTextColumn Header="Ability" Binding="{Binding Ability}" Width="60" />
              <DataGridTextColumn Header="Contract until" Binding="{Binding ContractEnd}" Width="100" />
              <DataGridTextColumn Header="Doing" Binding="{Binding Doing}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="Assignments" Style="{StaticResource Text.Title}" Margin="0,12,0,6" />
          <DataGrid Grid.Row="3" ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}" Style="{StaticResource Editor.Grid}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Scout" Binding="{Binding Scout}" Width="160" />
              <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" />
              <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="85" />
              <DataGridTextColumn Header="Reports on" Binding="{Binding Due}" Width="85" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
              <DataGridTextColumn Header="Reports" Binding="{Binding Reports}" Width="60" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="4" Text="Scouted players (estimates)" Style="{StaticResource Text.Title}" Margin="0,12,0,6" />
          <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBox Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Name contains" />
            <ComboBox ItemsSource="{Binding PositionOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SearchPosition}" Width="130" Margin="8,0,0,0" />
            <TextBox Text="{Binding SearchMaxAge, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0,0,0" ToolTip="Maximum age" />
            <TextBox Text="{Binding SearchMinOverall, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0,0,0" ToolTip="Minimum estimated overall" />
            <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
          </StackPanel>
          <DataGrid Grid.Row="6" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" Style="{StaticResource Editor.Grid}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="*" MinWidth="130" />
              <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="100" />
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="40" />
              <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="130" />
              <DataGridTextColumn Header="Overall" Binding="{Binding Overall}" Width="60" />
              <DataGridTextColumn Header="Potential" Binding="{Binding Potential}" Width="65" />
              <DataGridTextColumn Header="Accuracy" Binding="{Binding Accuracy}" Width="65" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" />
              <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="95" />
              <DataGridTextColumn Header="Report" Binding="{Binding Date}" Width="85" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="New assignment" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
                <TextBlock Text="Scout" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding AvailableScouts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ScoutId}" />
                <TextBlock Text="Focus" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding Focuses}" SelectedItem="{Binding Focus}" />
                <TextBlock Text="{Binding FocusHelp}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="Player (player focus)" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding Lookups.Players}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TargetPlayerId}" IsTextSearchEnabled="True" />
                <TextBlock Text="Country (region, youth)" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding Lookups.OptionalCountries}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TargetCountryId}" />
                <TextBlock Text="Competition (league)" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding Lookups.Competitions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TargetCompetitionId}" />
                <TextBlock Text="Position" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding PositionOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TargetPosition}" />
                <TextBlock Text="Maximum age" Style="{StaticResource Form.Label}" />
                <TextBox Text="{Binding MaxAge, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Send the scout" Command="{Binding AssignCommand}" />
                  <Button Content="Cancel selected assignment" Command="{Binding CancelAssignmentCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Selected report" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
                <TextBlock Text="Ranges hold the true value; better scouts, longer assignments and more visible players give narrower ranges." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ContentControl Content="{Binding ReportDetails}" ContentTemplate="{StaticResource Players.Lines}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

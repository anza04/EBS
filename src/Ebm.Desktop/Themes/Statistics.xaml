<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:st="clr-namespace:Ebm.Desktop.ViewModels.Statistics"
                    xmlns:ctl="clr-namespace:Ebm.Desktop.Controls">
  <!-- Season statistics of a club's players. Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->

  <DataTemplate DataType="{x:Type st:SeasonStatsViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClubId}" Width="240" />
        <TextBlock Text="Season" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="16,0,8,0" />
        <ComboBox ItemsSource="{Binding Seasons}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SeasonId}" Width="110" />
        <TextBlock Text="Competition" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="16,0,8,0" />
        <ComboBox ItemsSource="{Binding Competitions}" DisplayMemberPath="Name" SelectedItem="{Binding Competition}" Width="220" />
        <CheckBox Content="Per game" IsChecked="{Binding PerGame}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <!-- Shot chart of the selected player (Step 29) -->
        <DockPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{Binding ShotChartTitle}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ctl:ShotChartView DockPanel.Dock="Top" Shots="{Binding SelectedPlayer.Shots}" Margin="0,6,0,8" />
          <ContentControl Content="{Binding SelectedZones}" ContentTemplate="{StaticResource Matches.Zones}" />
        </DockPanel>
      <DataGrid ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}" Style="{StaticResource Editor.Grid}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="GP" Binding="{Binding Games}" Width="40" />
          <DataGridTextColumn Header="MIN" Binding="{Binding Minutes, StringFormat=0.#}" Width="50" />
          <DataGridTextColumn Header="PTS" Binding="{Binding Points, StringFormat=0.#}" Width="50" />
          <DataGridTextColumn Header="REB" Binding="{Binding Rebounds, StringFormat=0.#}" Width="50" />
          <DataGridTextColumn Header="OREB" Binding="{Binding OffensiveRebounds, StringFormat=0.#}" Width="50" />
          <DataGridTextColumn Header="AST" Binding="{Binding Assists, StringFormat=0.#}" Width="50" />
          <DataGridTextColumn Header="STL" Binding="{Binding Steals, StringFormat=0.#}" Width="45" />
          <DataGridTextColumn Header="BLK" Binding="{Binding Blocks, StringFormat=0.#}" Width="45" />
          <DataGridTextColumn Header="TO" Binding="{Binding Turnovers, StringFormat=0.#}" Width="45" />
          <DataGridTextColumn Header="PF" Binding="{Binding Fouls, StringFormat=0.#}" Width="45" />
          <DataGridTextColumn Header="FG" Binding="{Binding FieldGoals}" Width="80" SortMemberPath="FieldGoalPercentage" />
          <DataGridTextColumn Header="FG%" Binding="{Binding FieldGoalPercentage, StringFormat=P1}" Width="55" />
          <DataGridTextColumn Header="3P" Binding="{Binding Threes}" Width="70" SortMemberPath="ThreePointPercentage" />
          <DataGridTextColumn Header="3P%" Binding="{Binding ThreePointPercentage, StringFormat=P1}" Width="55" />
          <DataGridTextColumn Header="FT" Binding="{Binding FreeThrows}" Width="70" SortMemberPath="FreeThrowPercentage" />
          <DataGridTextColumn Header="FT%" Binding="{Binding FreeThrowPercentage, StringFormat=P1}" Width="55" />
          <DataGridTextColumn Header="TS%" Binding="{Binding TrueShooting, StringFormat=P1}" Width="55" />
          <DataGridTextColumn Header="eFG%" Binding="{Binding EffectiveFieldGoal, StringFormat=P1}" Width="55" />
          <DataGridTextColumn Header="TOV%" Binding="{Binding TurnoverRate, StringFormat=P1}" Width="55" />
          <DataGridTextColumn Header="+/-" Binding="{Binding PlusMinus, StringFormat=+0.#;-0.#;0}" Width="50" />
          <DataGridTextColumn Header="ORtg" Binding="{Binding OffensiveRating, StringFormat=0.0, TargetNullValue=—}" Width="50" />
          <DataGridTextColumn Header="DRtg" Binding="{Binding DefensiveRating, StringFormat=0.0, TargetNullValue=—}" Width="50" />
          <DataGridTextColumn Header="Net" Binding="{Binding NetRating, StringFormat=+0.0;-0.0;0, TargetNullValue=—}" Width="50" />
        </DataGrid.Columns>
      </DataGrid>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mt="clr-namespace:Ebm.Desktop.ViewModels.Matches">
  <!-- Match centre (Step 11). Uses the tokens from Shell.xaml, the styles from Editor.xaml and Players.Lines from Players.xaml. -->

  <BooleanToVisibilityConverter x:Key="Matches.Visible" />

  <DataTemplate x:Key="Matches.Box">
    <DataGrid ItemsSource="{Binding}" Style="{StaticResource Editor.Grid}" RowHeight="22" FontSize="12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*" MinWidth="120" />
        <DataGridTextColumn Header="Min" Binding="{Binding Minutes}" Width="36" />
        <DataGridTextColumn Header="Pts" Binding="{Binding Points}" Width="36" />
        <DataGridTextColumn Header="FG" Binding="{Binding FieldGoals}" Width="46" />
        <DataGridTextColumn Header="3P" Binding="{Binding Threes}" Width="40" />
        <DataGridTextColumn Header="FT" Binding="{Binding FreeThrows}" Width="40" />
        <DataGridTextColumn Header="Reb" Binding="{Binding Rebounds}" Width="36" />
        <DataGridTextColumn Header="Ast" Binding="{Binding Assists}" Width="36" />
        <DataGridTextColumn Header="Stl" Binding="{Binding Steals}" Width="34" />
        <DataGridTextColumn Header="Blk" Binding="{Binding Blocks}" Width="34" />
        <DataGridTextColumn Header="TO" Binding="{Binding Turnovers}" Width="32" />
        <DataGridTextColumn Header="PF" Binding="{Binding Fouls}" Width="32" />
        <DataGridTextColumn Header="+/-" Binding="{Binding PlusMinusText}" Width="38" />
        <DataGridTextColumn Header="En." Binding="{Binding EnergyText}" Width="36" />
      </DataGrid.Columns>
    </DataGrid>
  </DataTemplate>

  <DataTemplate x:Key="Matches.Sheet">
    <DataGrid ItemsSource="{Binding}" Style="{StaticResource Editor.Grid}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="*" />
        <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="100" />
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="70" />
        <DataGridTextColumn Header="Ovr" Binding="{Binding Overall}" Width="40" />
      </DataGrid.Columns>
    </DataGrid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type mt:MatchCenterViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Competition" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding CompetitionSeasons}" SelectedItem="{Binding SelectedCompetition}" DisplayMemberPath="Name" Width="260" />
        <Button Content="Create schedule" Command="{Binding CreateScheduleCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="20,0,0,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="270" />
        </Grid.ColumnDefinitions>

        <!-- Schedule and start -->
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="You manage" Style="{StaticResource Form.Label}" />
            <ComboBox ItemsSource="{Binding Sides}" SelectedItem="{Binding Managed}" IsEnabled="{Binding CanStart}" />
            <TextBlock Text="None = follow the commentary; the engine coaches both teams." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Start match" Command="{Binding StartMatchCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource Button.Secondary}" />
              <Button Content="Play instantly" Command="{Binding PlayInstantlyCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            </StackPanel>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Fixtures}" SelectedItem="{Binding SelectedFixture}" Style="{StaticResource Editor.Grid}" IsEnabled="{Binding CanBrowse}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="72" />
              <DataGridTextColumn Header="Rd" Binding="{Binding Round}" Width="28" />
              <DataGridTextColumn Header="Home" Binding="{Binding Home}" Width="80" />
              <DataGridTextColumn Header="Away" Binding="{Binding Away}" Width="80" />
              <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="50" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- Scoreboard and match views -->
        <DockPanel Grid.Column="1" Margin="12,0,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding HomeName}" Style="{StaticResource Text.Title}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding HomeInfo}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="20,0">
                <TextBlock Text="{Binding ScoreText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ClockText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding AwayName}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding AwayInfo}" Style="{StaticResource Text.Muted}" />
              </StackPanel>
            </Grid>
          </Border>
          <TabControl Margin="0,8,0,0" SelectedIndex="{Binding SelectedView}">
            <TabItem Header="Preview">
              <Grid Margin="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding HomeTactics}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Grid.Column="2" Text="{Binding AwayTactics}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ContentControl Grid.Row="1" Content="{Binding HomeSheet}" ContentTemplate="{StaticResource Matches.Sheet}" />
                <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding AwaySheet}" ContentTemplate="{StaticResource Matches.Sheet}" />
              </Grid>
            </TabItem>
            <TabItem Header="Play-by-play">
              <DataGrid ItemsSource="{Binding PlayByPlay}" Style="{StaticResource Editor.Grid}" Margin="8" RowHeight="22" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="72" />
                  <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="56" />
                  <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="130" />
                  <DataGridTextColumn Header="Play" Binding="{Binding Text}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Box score">
              <Grid Margin="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding HomeName}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                <ContentControl Grid.Row="1" Content="{Binding HomeBox}" ContentTemplate="{StaticResource Matches.Box}" />
                <TextBlock Grid.Row="2" Text="{Binding AwayName}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ContentControl Grid.Row="3" Content="{Binding AwayBox}" ContentTemplate="{StaticResource Matches.Box}" />
              </Grid>
            </TabItem>
            <TabItem Header="Team stats">
              <DataGrid ItemsSource="{Binding TeamStats}" Style="{StaticResource Editor.Grid}" Margin="8">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="" Binding="{Binding Label}" Width="140" />
                  <DataGridTextColumn Header="Home" Binding="{Binding Home}" Width="*" />
                  <DataGridTextColumn Header="Away" Binding="{Binding Away}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Report">
              <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource Players.Lines}" Margin="12" />
            </TabItem>
          </TabControl>
        </DockPanel>

        <!-- Live controls -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="12" Visibility="{Binding IsLive, Converter={StaticResource Matches.Visible}}">
              <StackPanel>
                <TextBlock Text="Game" Style="{StaticResource Text.Title}" />
                <Button Content="Next possession" Command="{Binding NextPossessionCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0" />
                <Button Content="To the end of the quarter" Command="{Binding ToEndOfQuarterCommand}" Style="{StaticResource Button.Secondary}" Margin="0,6,0,0" />
                <Button Content="To the end of the match" Command="{Binding ToEndOfMatchCommand}" Style="{StaticResource Button.Secondary}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0" Visibility="{Binding CanIntervene, Converter={StaticResource Matches.Visible}}">
              <StackPanel>
                <TextBlock Text="Substitution" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Out (on court · energy · fouls)" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding OnCourt}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SubOut}" />
                <TextBlock Text="In (bench)" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding Bench}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SubIn}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Substitute" Command="{Binding SubstituteCommand}" Style="{StaticResource Button.Secondary}" />
                  <Button Content="Timeout" Command="{Binding TimeoutCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="Tactics" Style="{StaticResource Text.Title}" Margin="0,14,0,0" />
                <TextBlock Text="Offense" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding OffensiveSystems}" SelectedItem="{Binding LiveOffense}" />
                <TextBlock Text="Defense" Style="{StaticResource Form.Label}" />
                <ComboBox ItemsSource="{Binding DefensiveSystems}" SelectedItem="{Binding LiveDefense}" />
                <TextBlock Text="Tempo · defensive intensity" Style="{StaticResource Form.Label}" />
                <UniformGrid Columns="2">
                  <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding LiveTempo}" Margin="0,0,4,0" />
                  <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding LiveIntensity}" />
                </UniformGrid>
                <Button Content="Apply tactics" Command="{Binding ApplyTacticsCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sv="clr-namespace:Ebm.Desktop.ViewModels.Saves">
  <!-- Saved games (Step 14). Uses the tokens from Shell.xaml and the styles from Editor.xaml. -->
  <DataTemplate DataType="{x:Type sv:SaveGamesViewModel}">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock Text="Saved games" Style="{StaticResource Text.Heading}" />
        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap">
          <Run Text="The game in progress is saved automatically after every action; a save is a copy you can return to. Folder: " />
          <Run Text="{Binding Folder, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Name" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" Width="220" />
        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
        <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
        <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
        <Button Content="New game" Command="{Binding NewGameCommand}" Style="{StaticResource Button.Secondary}" Margin="24,0,0,0" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding SaveGames}" SelectedItem="{Binding SelectedSave}" Style="{StaticResource Editor.Grid}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
          <DataGridTextColumn Header="Career" Binding="{Binding Career}" Width="*" />
          <DataGridTextColumn Header="Saved" Binding="{Binding SavedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
          <DataGridTextColumn Header="Schema" Binding="{Binding SchemaVersion}" Width="200" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>

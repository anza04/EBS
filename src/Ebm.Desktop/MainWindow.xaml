<Window x:Class="Ebm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ebm.Desktop.ViewModels"
        xmlns:c="clr-namespace:Ebm.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding WindowTitle}"
        Width="1280" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Shell.Visible" />
  </Window.Resources>
  <DockPanel>
    <!-- Top bar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1" Padding="18,10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource Text.Muted}"
                   VerticalAlignment="Center" Margin="24,0,0,0" />

        <!-- Locked club: preselected in every screen that works on one club -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding Editor}">
          <TextBlock Text="My club" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsClubUnlocked, Converter={StaticResource Shell.Visible}}">
            <ComboBox ItemsSource="{Binding Lookups.Clubs}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding ClubToLock}" Width="240" VerticalAlignment="Center" />
            <Button Content="🔒 Lock" Command="{Binding LockClubCommand}" Style="{StaticResource Button.Primary}"
                    Padding="12,4" Margin="8,0,0,0" ToolTip="Preselect this club in every tab, also in future sessions" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsClubLocked, Converter={StaticResource Shell.Visible}}">
            <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding LockedClubName, StringFormat='🔒 {0}'}" Style="{StaticResource Text.Body}" FontSize="13"
                         Foreground="{StaticResource Brush.AccentText}" FontWeight="SemiBold" />
            </Border>
            <Button Content="Unlock" Command="{Binding UnlockClubCommand}" Padding="12,4" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="20" Height="20" Fill="{StaticResource Brush.Accent}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding ProductName}" Style="{StaticResource Text.Title}" FontSize="17" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Padding="10,2" />
        <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center">
          <Run Text="{Binding Editor.Counts, Mode=OneWay}" /> <Run Text=" · Data folder:" /> <Run Text="{Binding DataFolder, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- Content area: grouped sidebar navigation. Tag = group label shown above the first item of each group. -->
    <TabControl DataContext="{Binding Editor}" Style="{StaticResource Nav.TabControl}" Padding="8,8,8,4"
                ItemContainerStyle="{StaticResource Nav.Item}">
      <TabItem Tag="GAME" Header="Career" c:Ui.Icon="&#xE80F;" Content="{Binding Career}" />
      <TabItem Header="News" c:Ui.Icon="&#xE715;" Content="{Binding News}" />
      <TabItem Header="Saved games" c:Ui.Icon="&#xE74E;" Content="{Binding Saves}" />
      <TabItem Tag="CLUB" Header="Club profile" c:Ui.Icon="&#xE825;" Content="{Binding ClubProfile}" />
      <TabItem Header="Finances" c:Ui.Icon="&#xE8EF;" Content="{Binding Finances}" />
      <TabItem Header="Staff" c:Ui.Icon="&#xE716;" Content="{Binding Staff}" />
      <TabItem Header="Club contracts" c:Ui.Icon="&#xE8A5;" Content="{Binding ClubContracts}" />
      <TabItem Tag="TEAM" Header="Squad" c:Ui.Icon="&#xE902;" Content="{Binding Squad}" />
      <TabItem Header="Tactics" c:Ui.Icon="&#xE7C1;" Content="{Binding Tactics}" />
      <TabItem Header="Training" c:Ui.Icon="&#xE9D9;" Content="{Binding Training}" />
      <TabItem Header="Medical" c:Ui.Icon="&#xE95E;" Content="{Binding Medical}" />
      <TabItem Header="Dressing room" c:Ui.Icon="&#xE76E;" Content="{Binding DressingRoom}" />
      <TabItem Tag="PLAYERS AND MARKET" Header="Players" c:Ui.Icon="&#xE77B;" Content="{Binding Players}" />
      <TabItem Header="Player profile" c:Ui.Icon="&#xE779;" Content="{Binding Profile}" />
      <TabItem Header="Compare players" c:Ui.Icon="&#xE8AB;" Content="{Binding Comparison}" />
      <TabItem Header="Transfer market" c:Ui.Icon="&#xE719;" Content="{Binding TransferMarket}" />
      <TabItem Header="Scouting" c:Ui.Icon="&#xE721;" Content="{Binding Scouting}" />
      <TabItem Tag="SEASON" Header="Matches" c:Ui.Icon="&#xE787;" Content="{Binding Matches}" />
      <TabItem Header="Season stats" c:Ui.Icon="&#xE9D2;" Content="{Binding SeasonStats}" />
      <TabItem Header="History" c:Ui.Icon="&#xE81C;" Content="{Binding History}" />
      <TabItem Tag="DATABASE" Header="Clubs" c:Ui.Icon="&#xE8F1;" Content="{Binding Clubs}" />
      <TabItem Header="Contracts (editor)" c:Ui.Icon="&#xE70F;" Content="{Binding Contracts}" />
      <TabItem Header="Leagues and competitions" c:Ui.Icon="&#xE8FD;">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="2*" />
          </Grid.RowDefinitions>
          <ContentControl Content="{Binding Leagues}" />
          <ContentControl Grid.Row="2" Content="{Binding Competitions}" />
        </Grid>
      </TabItem>
      <TabItem Header="Import" c:Ui.Icon="&#xE898;" Content="{Binding Import}" />
    </TabControl>
  </DockPanel>
</Window>

<Application x:Class="Ebm.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!-- No StartupUri: the window is created from the DI container in App.OnStartup. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Shell.xaml" />
        <ResourceDictionary Source="Themes/Editor.xaml" />
        <ResourceDictionary Source="Themes/Players.xaml" />
        <ResourceDictionary Source="Themes/Clubs.xaml" />
        <ResourceDictionary Source="Themes/Contracts.xaml" />
        <ResourceDictionary Source="Themes/Transfers.xaml" />
        <ResourceDictionary Source="Themes/Tactics.xaml" />
        <ResourceDictionary Source="Themes/Matches.xaml" />
        <ResourceDictionary Source="Themes/Careers.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
